\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Hybrid random Clifford circuit. Brickwork layers of random two-qubit Clifford gates (blue boxes labeled C) alternate with single-site measurements (red M symbols) applied independently at rate $p$. Even layers pair qubits $(0,1),(2,3),(4,5)$; odd layers pair $(1,2),(3,4)$. The competition between unitary scrambling and projective measurement drives the entanglement phase transition at $p = p_c$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:schematic}{{1}{3}{Hybrid random Clifford circuit. Brickwork layers of random two-qubit Clifford gates (blue boxes labeled C) alternate with single-site measurements (red M symbols) applied independently at rate $p$. Even layers pair qubits $(0,1),(2,3),(4,5)$; odd layers pair $(1,2),(3,4)$. The competition between unitary scrambling and projective measurement drives the entanglement phase transition at $p = p_c$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Half-chain entanglement entropy $S(L/2)$ vs.\ measurement rate $p$ for $L \in \{8, 12, 16, 20, 24\}$ (200 disorder realizations each; shaded bands: $\pm 1$ standard error of the mean). Adjacent-$L$ curve crossings average to $p_c \approx 0.203 \pm 0.017$, signaling the phase transition. For $p < p_c$, $S$ increases with $L$ (volume-law); for $p > p_c$, $S$ is approximately $L$-independent (area-law). The vertical dashed line marks the literature value $p_c \approx 0.16$~\cite {Li2019}.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:phase}{{2}{3}{Half-chain entanglement entropy $S(L/2)$ vs.\ measurement rate $p$ for $L \in \{8, 12, 16, 20, 24\}$ (200 disorder realizations each; shaded bands: $\pm 1$ standard error of the mean). Adjacent-$L$ curve crossings average to $p_c \approx 0.203 \pm 0.017$, signaling the phase transition. For $p < p_c$, $S$ increases with $L$ (volume-law); for $p > p_c$, $S$ is approximately $L$-independent (area-law). The vertical dashed line marks the literature value $p_c \approx 0.16$~\protect \cite {Li2019}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (Left) Phase diagram with critical region $p \in [0.13, 0.19]$ shaded. (Right) $S(L/2)$ vs.\ $\ln (L/2)$ at $p = 0.16 \approx p_c$. The linear fit (dashed red) gives slope $\alpha = 0.27 \pm 0.07$, to be compared with Li \textit  {et al.}~\cite {Li2019} ($\alpha \approx 1.6$; the remaining discrepancy reflects finite-$L$ corrections at the system sizes studied here). The coefficient $\alpha $ is the raw log-scaling exponent at the MIPT critical point; it is not a CFT central charge (see Sec.~\ref {sec:cft}).}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:logscale}{{3}{3}{(Left) Phase diagram with critical region $p \in [0.13, 0.19]$ shaded. (Right) $S(L/2)$ vs.\ $\ln (L/2)$ at $p = 0.16 \approx p_c$. The linear fit (dashed red) gives slope $\alpha = 0.27 \pm 0.07$, to be compared with Li \textit {et al.}~\protect \cite {Li2019} ($\alpha \approx 1.6$; the remaining discrepancy reflects finite-$L$ corrections at the system sizes studied here). The coefficient $\alpha $ is the raw log-scaling exponent at the MIPT critical point; it is not a CFT central charge (see Sec.~\protect \ref {sec:cft})}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Finite-size scaling collapse under the ansatz of Eq.~(\ref {eq:fss}). (Left) Raw $S(L/2)$ vs.\ $p$ for all five system sizes. (Right) Collapsed curves with optimized parameters $p_c = 0.209 \pm 0.008$, $\nu = 1.72 \pm 0.10$ (bootstrap, 100 resamples). Literature: $p_c \approx 0.16$, $\nu \approx 1.28$~\cite {Zabalo2020}. Residual finite-size bias at $L \leq 24$ is expected for the MIPT universality class.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:collapse}{{4}{3}{Finite-size scaling collapse under the ansatz of Eq.~(\ref {eq:fss}). (Left) Raw $S(L/2)$ vs.\ $p$ for all five system sizes. (Right) Collapsed curves with optimized parameters $p_c = 0.209 \pm 0.008$, $\nu = 1.72 \pm 0.10$ (bootstrap, 100 resamples). Literature: $p_c \approx 0.16$, $\nu \approx 1.28$~\protect \cite {Zabalo2020}. Residual finite-size bias at $L \leq 24$ is expected for the MIPT universality class}{figure.4}{}}
