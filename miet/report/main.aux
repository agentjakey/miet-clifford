\@writefile{toc}{\contentsline {subsection}{\numberline {}Phase Transition}{3}{section*.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Half-chain entanglement entropy $S(L/2)$ vs.\ measurement rate $p$ for $L \in \{8, 12, 16, 20, 24\}$ (200 disorder realizations each; shaded bands: $\pm 1$ standard error of the mean). Adjacent-$L$ curve crossings average to $p_c^{\mathrm  {eff}} \approx 0.20$ (finite-size effective estimate; statistical uncertainty $\pm 0.017$), signaling the qualitative onset of the phase transition. For $p < p_c^{\mathrm  {eff}}$, $S$ increases with $L$ (volume-law); for $p > p_c^{\mathrm  {eff}}$, $S$ is approximately $L$-independent (area-law). The vertical dashed line marks the thermodynamic value $p_c \approx 0.16$~\cite {Li2019}.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:phase}{{2}{3}{Half-chain entanglement entropy $S(L/2)$ vs.\ measurement rate $p$ for $L \in \{8, 12, 16, 20, 24\}$ (200 disorder realizations each; shaded bands: $\pm 1$ standard error of the mean). Adjacent-$L$ curve crossings average to $p_c^{\mathrm {eff}} \approx 0.20$ (finite-size effective estimate; statistical uncertainty $\pm 0.017$), signaling the qualitative onset of the phase transition. For $p < p_c^{\mathrm {eff}}$, $S$ increases with $L$ (volume-law); for $p > p_c^{\mathrm {eff}}$, $S$ is approximately $L$-independent (area-law). The vertical dashed line marks the thermodynamic value $p_c \approx 0.16$~\protect \cite {Li2019}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (Left) Phase diagram with critical region $p \in [0.13, 0.19]$ shaded. (Right) $S(L/2)$ vs.\ $\ln (L/2)$ at $p = 0.16$. The linear fit (dashed red) gives slope $\alpha _{\mathrm  {eff}} = 0.27 \pm 0.07$. This is not quantitatively consistent with the asymptotic value $\alpha \approx 1.6$~\cite {Li2019}; the suppression reflects off-critical evaluation and finite-size effects at $L \leq 24$ (see text). The coefficient $\alpha $ is not a CFT central charge (see Sec.~\ref {sec:cft}).}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:logscale}{{3}{3}{(Left) Phase diagram with critical region $p \in [0.13, 0.19]$ shaded. (Right) $S(L/2)$ vs.\ $\ln (L/2)$ at $p = 0.16$. The linear fit (dashed red) gives slope $\alpha _{\mathrm {eff}} = 0.27 \pm 0.07$. This is not quantitatively consistent with the asymptotic value $\alpha \approx 1.6$~\protect \cite {Li2019}; the suppression reflects off-critical evaluation and finite-size effects at $L \leq 24$ (see text). The coefficient $\alpha $ is not a CFT central charge (see Sec.~\protect \ref {sec:cft})}{figure.3}{}}
