\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Finite-size effective critical quantities from simulation vs.\ literature. System sizes $L \in \{8, 12, 16, 20, 24\}$, 200 samples per point. Reported $\pm $ values are bootstrap statistical errors only; systematic finite-size bias is the dominant source of deviation from thermodynamic values for $p_c^{\mathrm  {eff}}$, $\nu _{\mathrm  {eff}}$, and $\alpha _{\mathrm  {eff}}$.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:critical}{{I}{4}{Finite-size effective critical quantities from simulation vs.\ literature. System sizes $L \in \{8, 12, 16, 20, 24\}$, 200 samples per point. Reported $\pm $ values are bootstrap statistical errors only; systematic finite-size bias is the dominant source of deviation from thermodynamic values for $p_c^{\mathrm {eff}}$, $\nu _{\mathrm {eff}}$, and $\alpha _{\mathrm {eff}}$}{table.1}{}}
