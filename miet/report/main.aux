\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Qualitative finite-size scaling collapse under the simplified ansatz of Eq.~(\ref {eq:fss}) (without the critical logarithm; see text). (Left) Raw $S(L/2)$ vs.\ $p$ for all five system sizes. (Right) Collapsed curves with finite-size effective parameters $p_c^{\mathrm  {eff}} = 0.209 \pm 0.008$, $\nu _{\mathrm  {eff}} = 1.72 \pm 0.10$ (bootstrap statistical uncertainty, 100 resamples). Thermodynamic values: $p_c \approx 0.16$, $\nu \approx 1.28$~\cite {Zabalo2020}. The systematic deviation from literature values is expected at $L \leq 24$; the quoted $\pm $ values are statistical only.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:collapse}{{4}{4}{Qualitative finite-size scaling collapse under the simplified ansatz of Eq.~(\ref {eq:fss}) (without the critical logarithm; see text). (Left) Raw $S(L/2)$ vs.\ $p$ for all five system sizes. (Right) Collapsed curves with finite-size effective parameters $p_c^{\mathrm {eff}} = 0.209 \pm 0.008$, $\nu _{\mathrm {eff}} = 1.72 \pm 0.10$ (bootstrap statistical uncertainty, 100 resamples). Thermodynamic values: $p_c \approx 0.16$, $\nu \approx 1.28$~\protect \cite {Zabalo2020}. The systematic deviation from literature values is expected at $L \leq 24$; the quoted $\pm $ values are statistical only}{figure.4}{}}
