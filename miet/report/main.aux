\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Diagnostic finite-size scaling collapse under the simplified ansatz of Eq.~(\ref {eq:fss}) (without the critical logarithm; see text). (Left) Raw $S(L/2)$ vs.\ $p$ for all five system sizes. (Right) Collapsed curves with finite-size effective parameters $p_c^{\mathrm  {eff}} = 0.209 \pm 0.008$, $\nu _{\mathrm  {eff}} = 1.72 \pm 0.10$ (bootstrap statistical uncertainty, 100 resamples). Because the raw entropy contains additive logarithmic corrections at $p_c$ [Eq.~(\ref {eq:logscale})], the fitted $p_c^{\mathrm  {eff}}$ and $\nu _{\mathrm  {eff}}$ should not be interpreted as precision thermodynamic estimates; the collapse is qualitative. Thermodynamic values: $p_c \approx 0.16$, $\nu \approx 1.28$~\cite {Zabalo2020}. Quoted $\pm $ values are statistical only.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:collapse}{{4}{4}{Diagnostic finite-size scaling collapse under the simplified ansatz of Eq.~(\ref {eq:fss}) (without the critical logarithm; see text). (Left) Raw $S(L/2)$ vs.\ $p$ for all five system sizes. (Right) Collapsed curves with finite-size effective parameters $p_c^{\mathrm {eff}} = 0.209 \pm 0.008$, $\nu _{\mathrm {eff}} = 1.72 \pm 0.10$ (bootstrap statistical uncertainty, 100 resamples). Because the raw entropy contains additive logarithmic corrections at $p_c$ [Eq.~(\ref {eq:logscale})], the fitted $p_c^{\mathrm {eff}}$ and $\nu _{\mathrm {eff}}$ should not be interpreted as precision thermodynamic estimates; the collapse is qualitative. Thermodynamic values: $p_c \approx 0.16$, $\nu \approx 1.28$~\protect \cite {Zabalo2020}. Quoted $\pm $ values are statistical only}{figure.4}{}}
