\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Half-chain entanglement entropy $S(L/2)$ vs.\ measurement rate $p$ for $L \in \{8, 12, 16, 20, 24\}$ (200 disorder realizations each; shaded bands: $\pm 1$ standard error of the mean). The curves show finite-size signatures of the volume-law regime ($S$ growing with $L$ at low $p$) and the area-law regime ($S$ approximately $L$-independent at high $p$); the thermodynamic transition is not fully resolved at these system sizes. Adjacent-$L$ curve crossings yield a finite-size effective critical rate $p_c^{\mathrm  {eff}} \approx 0.20$ (statistical uncertainty $\pm 0.017$), which lies above the thermodynamic value $p_c \approx 0.16$~\cite {Li2019} due to expected finite-size corrections.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:phase}{{2}{3}{Half-chain entanglement entropy $S(L/2)$ vs.\ measurement rate $p$ for $L \in \{8, 12, 16, 20, 24\}$ (200 disorder realizations each; shaded bands: $\pm 1$ standard error of the mean). The curves show finite-size signatures of the volume-law regime ($S$ growing with $L$ at low $p$) and the area-law regime ($S$ approximately $L$-independent at high $p$); the thermodynamic transition is not fully resolved at these system sizes. Adjacent-$L$ curve crossings yield a finite-size effective critical rate $p_c^{\mathrm {eff}} \approx 0.20$ (statistical uncertainty $\pm 0.017$), which lies above the thermodynamic value $p_c \approx 0.16$~\protect \cite {Li2019} due to expected finite-size corrections}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (Left) Phase diagram with critical region $p \in [0.13, 0.19]$ shaded. (Right) $S(L/2)$ vs.\ $\ln (L/2)$ at $p = 0.16$ (grid point closest to the literature $p_c$). The linear fit (dashed red) yields the small-system fit coefficient $\alpha _{\mathrm  {eff}} = 0.27 \pm 0.07$, which is not quantitatively consistent with the asymptotic value $\alpha \approx 1.6$~\cite {Li2019} (established at $L \gg 100$); the suppression reflects off-critical evaluation and finite-size effects at $L \leq 24$ (see text). The figure provides evidence of qualitative critical-like logarithmic growth; it does not resolve the asymptotic exponent. The coefficient $\alpha $ is not a CFT central charge (see Sec.~\ref {sec:cft}).}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:logscale}{{3}{3}{(Left) Phase diagram with critical region $p \in [0.13, 0.19]$ shaded. (Right) $S(L/2)$ vs.\ $\ln (L/2)$ at $p = 0.16$ (grid point closest to the literature $p_c$). The linear fit (dashed red) yields the small-system fit coefficient $\alpha _{\mathrm {eff}} = 0.27 \pm 0.07$, which is not quantitatively consistent with the asymptotic value $\alpha \approx 1.6$~\protect \cite {Li2019} (established at $L \gg 100$); the suppression reflects off-critical evaluation and finite-size effects at $L \leq 24$ (see text). The figure provides evidence of qualitative critical-like logarithmic growth; it does not resolve the asymptotic exponent. The coefficient $\alpha $ is not a CFT central charge (see Sec.~\protect \ref {sec:cft})}{figure.3}{}}
